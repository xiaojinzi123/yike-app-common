<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application>
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity android:name=".QianjiAutoRecordActivity" android:exported="false" />
        <activity android:name=".QianjiRecognitionLabActivity" android:exported="false" />
        <activity
            android:name=".QianjiImportActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="导入到小亚">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.sqlite3" />
                <data android:mimeType="application/x-sqlite3" />
                <data android:mimeType="application/x-sqlite" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.sqlite3" />
                <data android:mimeType="application/x-sqlite3" />
                <data android:mimeType="application/x-sqlite" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- 钱迹工具页：数据库导入 / 文件导入 / 无障碍入口 -->
        <activity
            android:name=".QianjiToolsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing" />

        <!-- 预算页：总预算 + 分类预算（按月） -->
        <activity
            android:name=".BudgetActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 自动记账确认页：无障碍服务抓到支付信号后弹出 -->
        <activity
            android:name=".QianjiConfirmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- 钱迹式无障碍自动记账：系统绑定，必须 exported=true -->
        <service
            android:name=".QianjiAutoRecordService"
            android:exported="true"
            android:label="小亚自动记账"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/qianji_accessibility_config" />
        </service>

    </application>

</manifest>
